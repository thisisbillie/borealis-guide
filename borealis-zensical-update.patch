+.md-typeset .borealis-guide-card h2 { margin-top: 0; font-size: 1.15rem; }
+.md-typeset .borealis-guide-card p { color: var(--borealis-muted); }
+.md-typeset .borealis-guide-card a { font-weight: 600; }
+
+@media (max-width: 760px) {
+  .md-typeset .borealis-guide-grid { grid-template-columns: 1fr; }
+  .md-header__button.md-logo img { height: 40px; }
+}
