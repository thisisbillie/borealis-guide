+"User Guide" = "Guide d’utilisation"
+"Admin Guide" = "Guide d’administration"
+"API Guide" = "Guide API"
+"Getting Started" = "Pour commencer"
+"Find Data" = "Trouver des données"
+"Deposit Data" = "Déposer des données"
+"Help and Resources" = "Aide et ressources"
+"Manage Collections" = "Gérer les collections"
+"Authentication" = "Authentification"
