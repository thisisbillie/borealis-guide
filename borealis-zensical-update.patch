diff --git a/scripts/check_site.py b/scripts/check_site.py
new file mode 100644
index 0000000..493b56c
--- /dev/null
+++ b/scripts/check_site.py
@@ -0,0 +1,67 @@
+"""Check built pages, local assets, and EN/FR counterparts using only stdlib."""
+import json
+from html.parser import HTMLParser
+from pathlib import Path
+from urllib.parse import unquote, urljoin, urlsplit
+
+ROOT = Path(__file__).resolve().parents[1] / "site"
+BASE = "https://thisisbillie.github.io/borealis-guide/"
+
+
+class Links(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.urls = []
+        self.languages = {}
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        for key in ("href", "src"):
+            if attrs.get(key):
+                self.urls.append(attrs[key])
+        if tag == "a" and attrs.get("data-md-i18n-locale"):
+            self.languages[attrs["data-md-i18n-locale"]] = attrs["href"]
+
+
+def target(url):
+    parsed = urlsplit(url)
+    if parsed.netloc != urlsplit(BASE).netloc:
+        return None
+    prefix = urlsplit(BASE).path
+    assert parsed.path.startswith(prefix), f"Link escapes GitHub Pages base: {url}"
+    path = ROOT / unquote(parsed.path.removeprefix(prefix))
+    return path / "index.html" if path.is_dir() else path
+
+
+def main():
+    manifest = json.loads((ROOT / "zensical-i18n.json").read_text())["pages"]
+    assert set(manifest) == {"en", "fr"}, "Both languages must be built"
+    assert set(manifest["en"]) == set(manifest["fr"]), "Missing page counterparts"
+    checked = 0
+    for locale, pages in manifest.items():
+        language_base = BASE + ("fr/" if locale == "fr" else "")
+        for page in pages:
+            url = language_base + page
+            path = target(url)
+            assert path and path.is_file(), f"Missing page: {url}"
+            parser = Links()
+            parser.feed(path.read_text())
+            for link in parser.urls:
+                absolute = urljoin(url, link)
+                if urlsplit(absolute).scheme not in {"http", "https"}:
+                    continue
+                local = target(absolute)
+                assert local is None or local.is_file(), f"Broken link on {url}: {link}"
+            for other in ("en", "fr"):
+                expected = target(BASE + ("fr/" if other == "fr" else "") + page)
+                actual = target(urljoin(url, parser.languages[other]))
+                assert actual == expected, f"Wrong {other} counterpart on {url}"
+            checked += 1
+    fallback = (ROOT / "fr/find-data/index.html").read_text()
+    assert 'class="md-i18n-notice" role="note" lang="fr"' in fallback
+    assert '<article class="md-content__inner md-typeset" lang="en"' in fallback
+    print(f"Checked {checked} pages: local links, assets, language counterparts, and fallback notice.")
+
+
+if __name__ == "__main__":
+    main()
