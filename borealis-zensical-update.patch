+  letter-spacing: -.025em;
+  margin: .4rem 0 .6rem;
+}
+.md-typeset .borealis-hero p { color: var(--borealis-muted); }
+.md-typeset .borealis-hero .borealis-home-logo {
+  display: block;
+  max-width: min(240px, 100%);
+  height: auto;
+  padding: .6rem 1rem;
