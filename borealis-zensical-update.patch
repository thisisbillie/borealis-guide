+  --borealis-card: #23283d;
+  --borealis-glass: rgb(27 31 52 / 58%);
+  --borealis-muted: #c5cadd;
+}
+
+.md-header, .md-tabs {
+  background: #292b4b;
+  color: #fff;
+}
+
+.md-header__button.md-logo { padding: .2rem; }
+.md-header__button.md-logo img {
+  width: auto;
+  height: 48px;
+  max-width: 140px;
+  object-fit: contain;
