+
+/* Keep syntax token colours supplied by each theme. */
+.md-typeset .highlight {
+  background: var(--md-code-bg-color);
+  border: 1px solid var(--borealis-border);
+  border-radius: 8px;
+  overflow: hidden;
+}
+.md-typeset pre { background: var(--md-code-bg-color); }
+.md-typeset pre > code {
+  background: var(--md-code-bg-color);
+  color: var(--md-code-fg-color);
+  overflow-x: auto;
