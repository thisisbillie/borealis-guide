+[project]
+site_name = "Borealis Guides"
+site_description = "Find, share, and manage research data with Borealis."
+site_url = "https://thisisbillie.github.io/borealis-guide/"
+repo_url = "https://github.com/thisisbillie/borealis-guide"
+repo_name = "thisisbillie/borealis-guide"
+edit_uri = "edit/main/docs/"
+extra_css = ["stylesheets/extra.css"]
+
+# Keep the existing page paths so existing links continue to work.
+nav = [
+  { "User Guide" = [
+    "user-guide/index.md",
+    { "Getting Started" = "getting-started.md" },
+    { "Find Data" = "find-data.md" },
+    { "Deposit Data" = "deposit-data.md" },
+    { "Help and Resources" = "support.md" },
+  ] },
+  { "Admin Guide" = [
+    "admin-guide/index.md",
+    { "Manage Collections" = "manage-collections.md" },
+  ] },
+  { "API Guide" = [
+    "api-guide/index.md",
+    { "Authentication" = "api-guide/authentication.md" },
+    { "Search API" = "api-guide/search.md" },
+  ] },
+]
+
+[project.theme]
+language = "en"
+logo = "images/borealis-logo.png"
+favicon = "images/borealis-logo.png"
+features = [
+  "navigation.tabs",
+  "navigation.tabs.sticky",
+  "navigation.sections",
+  "navigation.indexes",
+  "navigation.path",
+  "navigation.tracking",
+  "navigation.top",
+  "toc.follow",
+  "content.code.copy",
+  "content.action.edit",
+  "search.highlight",
+]
+
+[[project.theme.palette]]
+media = "(prefers-color-scheme: light)"
+scheme = "default"
+toggle.icon = "lucide/moon"
+toggle.name = "Switch to dark mode"
+
+[[project.theme.palette]]
+media = "(prefers-color-scheme: dark)"
+scheme = "slate"
+toggle.icon = "lucide/sun"
+toggle.name = "Switch to light mode"
+
+[project.markdown_extensions]
+admonition = {}
+attr_list = {}
+md_in_html = {}
+toc.permalink = true
+pymdownx.details = {}
+pymdownx.highlight.pygments_lang_class = true
+pymdownx.superfences = {}
+
+[project.plugins.i18n]
+docs_structure = "suffix"
+fallback_to_default = true
+reconfigure_theme = true
+
+[[project.plugins.i18n.languages]]
+locale = "en"
+name = "English"
+default = true
+
+[[project.plugins.i18n.languages]]
+locale = "fr"
+name = "Français"
+site_name = "Guides Borealis"
+site_description = "Trouver, partager et gérer des données de recherche avec Borealis."
+untranslated_notice = "Cette page n’est pas encore disponible en français. Le contenu anglais est présenté ci-dessous."
+
